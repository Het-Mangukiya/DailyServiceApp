<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Widget Style -->
    <style name="Widget.App" parent=""/>
    
    <!-- Button Styles -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="android:elevation">@dimen/elevation_none</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>
    
    <style name="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
    
    <style name="Widget.App.Button.Secondary">
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
    
    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="Widget.App.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    
    <!-- Card Styles -->
    <style name="Widget.App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner_radius_lg</item>
        <item name="cardElevation">@dimen/elevation_sm</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">@dimen/spacing_md</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>
    
    <style name="Widget.App.Card.Elevated">
        <item name="cardElevation">@dimen/elevation_md</item>
    </style>
    
    <style name="Widget.App.Card.Interactive">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
    
    <style name="Widget.App.Card.Stat">
        <item name="cardCornerRadius">@dimen/corner_radius_xl</item>
        <item name="cardElevation">@dimen/elevation_xs</item>
        <item name="contentPadding">@dimen/spacing_lg</item>
    </style>
    
    <!-- Text Input Styles -->
    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_md</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="errorTextColor">@color/error</item>
        <item name="helperTextTextColor">@color/text_tertiary</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>
    
    <style name="Widget.App.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textSize">@dimen/text_size_base</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
    </style>
    
    <!-- Chip Styles -->
    <style name="Widget.App.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/corner_radius_full</item>
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>
    
    <style name="Widget.App.Chip.Role">
        <item name="chipBackgroundColor">@color/role_badge_customer_bg</item>
        <item name="android:textColor">@color/role_badge_customer_text</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>
    
    <!-- Bottom Navigation -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemRippleColor">?attr/colorControlHighlight</item>
        <item name="elevation">@dimen/elevation_md</item>
        <item name="backgroundTint">@color/surface</item>
    </style>
    
    <!-- Progress Indicator -->
    <style name="Widget.App.CircularProgressIndicator" parent="Widget.MaterialComponents.CircularProgressIndicator">
        <item name="indicatorColor">@color/primary</item>
        <item name="trackColor">@color/surface_variant</item>
        <item name="trackThickness">4dp</item>
    </style>
    
    <!-- Divider -->
    <style name="Widget.App.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/border</item>
    </style>
</resources>

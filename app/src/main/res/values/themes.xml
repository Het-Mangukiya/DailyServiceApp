<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.DailyServiceApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorSurface">@color/md_theme_surface</item>
    </style>

    <style name="Theme.DailyServiceApp" parent="Base.Theme.DailyServiceApp" />
    
    <style name="Theme.DailyServiceApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Text Appearances -->
    <style name="TextAppearance.App" parent="TextAppearance.Material3.BodyMedium" />
    
    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium" />
    
    <style name="TextAppearance.App.Headline.Large" parent="TextAppearance.Material3.HeadlineLarge" />
    
    <style name="TextAppearance.App.Headline.Medium" parent="TextAppearance.Material3.HeadlineMedium" />
    
    <style name="TextAppearance.App.Headline.Small">
        <item name="android:textSize">@dimen/text_size_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.Title">
        <item name="android:textSize">@dimen/text_size_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium" />
    
    <style name="TextAppearance.App.Body.Medium" parent="TextAppearance.Material3.BodyMedium" />

    <style name="TextAppearance.App.Body.Small">
        <item name="android:textSize">@dimen/text_size_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelLarge" />

    <!-- Card Styles -->
    <style name="Widget" />
    <style name="Widget.App" />
    
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="cardElevation">@dimen/elevation_base</item>
    </style>
    
    <style name="Widget.App.Card.Elevated" parent="Widget.Material3.CardView.Elevated" />
    
    <!-- Button Styles -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button" />
    
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton" />
    
    <!-- Text Input Styles -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox" />
    
    <style name="Widget.App.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox" />
    
    <!-- Progress Indicator -->
    <style name="Widget.App.CircularProgressIndicator" parent="Widget.Material3.CircularProgressIndicator" />
    
    <!-- Divider -->
    <style name="Widget.App.Divider">
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/md_theme_on_surface_variant</item>
    </style>
</resources>

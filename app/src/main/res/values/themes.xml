<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.DailyServiceApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_light</item>
        <item name="colorOnPrimaryContainer">@color/teal_dark</item>
        <item name="colorSecondary">@color/status_active</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/bg_light</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/bg_light</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_grey</item>
        <item name="colorError">@color/status_due</item>
        <item name="colorOutline">@color/divider_color</item>
        <item name="android:statusBarColor">@color/teal_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
    <style name="Widget.App" parent="Widget.MaterialComponents.Button">
    </style>
    <style name="Theme.DailyServiceApp" parent="Base.Theme.DailyServiceApp" />
    
    <style name="Theme.DailyServiceApp.NoActionBar" parent="Theme.DailyServiceApp">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Global Component Styles for Build Stability -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>
    
    <style name="Widget.App.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
    </style>
    
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/teal_primary</item>
    </style>
    
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/teal_primary</item>
        <item name="android:textColor">@color/teal_primary</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    
    <style name="Widget.App.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox" />
    
    <style name="Widget.App.CircularProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/teal_primary</item>
    </style>

    <!-- Legacy Style Support to prevent crashes -->
    <style name="TextAppearance.App.Headline.Large" parent="TextAppearance.Material3.HeadlineLarge" />
    <style name="TextAppearance.App.Body.Medium" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelLarge" />
    <style name="Widget.App.Divider">
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider_color</item>
    </style>

</resources>

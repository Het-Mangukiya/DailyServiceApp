<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Main Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <!-- App Bar with Green Header -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/secondary"
            app:elevation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:paddingStart="@dimen/spacing_base"
                android:paddingEnd="@dimen/spacing_base"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_sm">

                <!-- Hamburger Menu -->
                <ImageView
                    android:id="@+id/menuIcon"
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@android:drawable/ic_menu_more"
                    android:tint="@android:color/white"
                    android:contentDescription="Menu"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Title -->
                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Products"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_size_lg"
                    android:textStyle="bold"
                    android:layout_marginStart="@dimen/spacing_base"
                    app:layout_constraintStart_toEndOf="@id/menuIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Header Icons Row -->
                <LinearLayout
                    android:id="@+id/headerIconsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/bellIcon"
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@android:drawable/ic_menu_view"
                        android:tint="@android:color/white"
                        android:contentDescription="Notifications"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:padding="@dimen/spacing_xs" />

                    <ImageView
                        android:id="@+id/calendarIcon"
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@android:drawable/ic_menu_today"
                        android:tint="@android:color/white"
                        android:contentDescription="Calendar"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:padding="@dimen/spacing_xs" />

                    <ImageView
                        android:id="@+id/sparkleIcon"
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@android:drawable/ic_menu_manage"
                        android:tint="@android:color/white"
                        android:contentDescription="Features"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:padding="@dimen/spacing_xs" />

                    <ImageView
                        android:id="@+id/gridIcon"
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@android:drawable/ic_menu_view"
                        android:tint="@android:color/white"
                        android:contentDescription="View Options"
                        android:padding="@dimen/spacing_xs" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Toolbar (hidden, used for drawer toggle) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/secondary"
            android:visibility="gone"
            app:title="Products"
            app:titleTextColor="@android:color/white" />

        <!-- Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Summary Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_base"
                    android:paddingEnd="@dimen/spacing_base"
                    android:paddingTop="@dimen/spacing_base"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:weightSum="2">

                    <!-- Products Count Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        app:cardBackgroundColor="#80000000"
                        app:cardCornerRadius="@dimen/corner_radius_lg"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/spacing_base">

                            <ImageView
                                android:layout_width="@dimen/icon_size_lg"
                                android:layout_height="@dimen/icon_size_lg"
                                android:src="@android:drawable/ic_menu_view"
                                android:tint="@android:color/white"
                                android:layout_marginBottom="@dimen/spacing_xs" />

                            <TextView
                                android:id="@+id/productsCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Products"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/text_size_base"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Total Value Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        app:cardBackgroundColor="#80000000"
                        app:cardCornerRadius="@dimen/corner_radius_lg"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/spacing_base">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/text_size_xl"
                                android:layout_marginBottom="@dimen/spacing_xs" />

                            <TextView
                                android:id="@+id/totalValueText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0 Total Value"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/text_size_base"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Search Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_base"
                    android:layout_marginEnd="@dimen/spacing_base"
                    android:layout_marginBottom="@dimen/spacing_base"
                    app:cardCornerRadius="@dimen/corner_radius_md"
                    app:cardElevation="@dimen/elevation_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/spacing_base">

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@android:drawable/ic_menu_search"
                            android:tint="@color/text_secondary"
                            android:layout_marginEnd="@dimen/spacing_sm" />

                        <EditText
                            android:id="@+id/searchEditText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Search products by name or category..."
                            android:background="@null"
                            android:inputType="text"
                            android:textSize="@dimen/text_size_base" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Products List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/productsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/spacing_base"
                    android:paddingEnd="@dimen/spacing_base"
                    android:paddingBottom="@dimen/spacing_xxxl" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/emptyStateView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_xxxl"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@android:drawable/ic_menu_view"
                        android:tint="@color/text_tertiary"
                        android:layout_marginBottom="@dimen/spacing_base" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No products yet"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_lg"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap &quot;Add Product&quot; to create your first item."
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_base"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Floating Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addProductFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/spacing_base"
            android:text="Add Product"
            android:contentDescription="Add Product"
            android:textColor="@android:color/white"
            android:drawableStart="@android:drawable/ic_input_add"
            android:drawablePadding="@dimen/spacing_sm"
            android:drawableTint="@android:color/white"
            app:backgroundTint="@color/secondary"
            app:cornerRadius="@dimen/corner_radius_md" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>


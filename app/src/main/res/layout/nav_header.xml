<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@drawable/bg_nav_header_gradient"
    android:orientation="vertical"
    android:padding="@dimen/spacing_base"
    android:gravity="bottom">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="@dimen/spacing_base"
        android:elevation="@dimen/elevation_base"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="32dp">

        <TextView
            android:id="@+id/userInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/default_user_initial"
            android:contentDescription="@string/profile_initial_description"
            android:textSize="@dimen/text_size_xxl"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/default_user_name"
        android:textSize="@dimen/text_size_lg"
        android:textStyle="bold"
        android:textColor="@android:color/white" />

    <TextView
        android:id="@+id/userEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/default_user_email"
        android:textSize="@dimen/text_size_base"
        android:textColor="@android:color/white"
        android:layout_marginTop="@dimen/spacing_xs" />

</LinearLayout>

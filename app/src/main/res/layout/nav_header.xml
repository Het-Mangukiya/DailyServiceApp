<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@color/secondary"
    android:orientation="vertical"
    android:padding="@dimen/spacing_base"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Profile Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="@dimen/spacing_base"
            app:cardCornerRadius="@dimen/corner_radius_round"
            app:cardBackgroundColor="@color/secondary_light"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@android:color/white"
                android:scaleType="centerCrop"
                android:padding="@dimen/spacing_base" />

        </com.google.android.material.card.MaterialCardView>

        <!-- User Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USER"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="user@example.com"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_sm"
                android:alpha="0.9"
                android:layout_marginTop="@dimen/spacing_xs" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>


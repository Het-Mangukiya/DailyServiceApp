<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fitsSystemWindows="true">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_primary"
        app:elevation="@dimen/elevation_md">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Bills"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_base">

            <!-- Month Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/monthSelectorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_base"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_base"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_base"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/card_size_md"
                        android:layout_height="@dimen/card_size_md"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:tint="@color/md_theme_primary"
                        android:layout_marginEnd="@dimen/spacing_base" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Billing Period"
                            android:textSize="@dimen/text_size_sm"
                            android:textColor="@color/md_theme_on_surface_variant" />

                        <TextView
                            android:id="@+id/selectedMonthText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="January 2026"
                            android:textSize="@dimen/text_size_lg"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_on_surface"
                            android:layout_marginTop="@dimen/spacing_xs" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/previousMonthButton"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="@dimen/card_size_lg"
                        android:layout_height="@dimen/card_size_lg"
                        android:text="◄"
                        android:textSize="@dimen/text_size_lg"
                        app:iconSize="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nextMonthButton"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="@dimen/card_size_lg"
                        android:layout_height="@dimen/card_size_lg"
                        android:text="►"
                        android:textSize="@dimen/text_size_lg"
                        app:iconSize="0dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bills RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/billsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_xl"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="64sp"
                    android:layout_marginBottom="@dimen/spacing_base" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Bills for This Month"
                    android:textSize="@dimen/text_size_lg"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_on_surface"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Generate bills from service entries"
                    android:textSize="@dimen/text_size_base"
                    android:textColor="@color/md_theme_on_surface_variant"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FAB for Generate Bills -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/generateBillsFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_base"
        android:text="Generate Bills"
        android:textColor="@android:color/white"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@android:color/white"
        app:backgroundTint="@color/md_theme_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

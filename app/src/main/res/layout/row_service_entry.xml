<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/corner_radius_md"
    app:cardElevation="@dimen/elevation_base"
    app:cardBackgroundColor="@color/md_theme_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_base">

        <!-- Customer Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/customerAvatar"
            android:layout_width="@dimen/card_size_lg"
            android:layout_height="@dimen/card_size_lg"
            app:cardCornerRadius="@dimen/corner_radius_pill"
            app:cardBackgroundColor="@color/color_customers"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/customerInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="A"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Customer Info -->
        <LinearLayout
            android:id="@+id/customerInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_base"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/customerAvatar"
            app:layout_constraintStart_toEndOf="@id/customerAvatar"
            app:layout_constraintEnd_toStartOf="@id/quantityControls">

            <TextView
                android:id="@+id/customerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textSize="@dimen/text_size_base"
                android:textStyle="bold"
                android:textColor="@color/md_theme_on_surface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/serviceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Service • Quantity"
                android:textSize="@dimen/text_size_sm"
                android:textColor="@color/md_theme_on_surface_variant"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/spacing_xs" />
        </LinearLayout>

        <!-- Quantity Controls -->
        <LinearLayout
            android:id="@+id/quantityControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/decreaseButton"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="@dimen/card_size_md"
                android:layout_height="@dimen/card_size_md"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="-"
                android:textSize="@dimen/text_size_lg"
                app:cornerRadius="@dimen/corner_radius_base"
                app:iconSize="0dp" />

            <TextView
                android:id="@+id/quantityText"
                android:layout_width="@dimen/card_size_lg"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:textColor="@color/md_theme_on_surface"
                android:gravity="center"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/increaseButton"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="@dimen/card_size_md"
                android:layout_height="@dimen/card_size_md"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+"
                android:textSize="@dimen/text_size_lg"
                app:cornerRadius="@dimen/corner_radius_base"
                app:iconSize="0dp" />
        </LinearLayout>

        <!-- Delivery Checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/deliveryCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivered"
            android:textSize="@dimen/text_size_sm"
            android:textColor="@color/md_theme_on_surface"
            app:buttonTint="@color/md_theme_primary"
            android:layout_marginTop="@dimen/spacing_base"
            app:layout_constraintTop_toBottomOf="@id/customerAvatar"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

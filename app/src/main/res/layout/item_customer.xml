<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Customer Initial Circle -->
        <TextView
            android:id="@+id/customerInitial"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/initial_placeholder"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_circle_minimal"
            android:gravity="center"
            android:layout_marginEnd="16dp"
            app:backgroundTint="@color/md_theme_primary"/>

        <!-- Customer Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/customerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/customer_default"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_on_surface"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/customerService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/service_option_milk"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:drawablePadding="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot_separator"
                    android:textColor="@color/text_muted"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/customerRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rate_day_placeholder"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"/>

            </LinearLayout>

            <!-- Pending Amount (if any) -->
            <TextView
                android:id="@+id/customerPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pending_placeholder"
                android:textSize="13sp"
                android:textColor="@color/md_theme_error"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Today's Status Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp">

            <!-- Vacation Badge -->
            <TextView
                android:id="@+id/vacationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/on_vacation"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_error"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/check_mark"
                android:textSize="20sp"
                android:textColor="@color/md_theme_primary"
                android:textStyle="bold"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delivered_label"
                android:textSize="11sp"
                android:textColor="@color/md_theme_primary"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

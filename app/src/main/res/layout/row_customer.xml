<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/corner_radius_md"
    app:cardElevation="@dimen/elevation_base"
    app:cardBackgroundColor="@color/md_theme_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_base">

        <!-- Customer Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/customerAvatar"
            android:layout_width="@dimen/card_size_lg"
            android:layout_height="@dimen/card_size_lg"
            app:cardCornerRadius="@dimen/corner_radius_pill"
            app:cardBackgroundColor="@color/color_customers"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/customerInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Customer Info -->
        <LinearLayout
            android:id="@+id/customerInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_base"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/customerAvatar"
            app:layout_constraintEnd_toStartOf="@id/customerStatus">

            <TextView
                android:id="@+id/customerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textSize="@dimen/text_size_base"
                android:textStyle="bold"
                android:textColor="@color/md_theme_on_surface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/customerService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Service Type · ₹0.00/unit"
                android:textSize="@dimen/text_size_sm"
                android:textColor="@color/md_theme_on_surface_variant"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/spacing_xs" />

            <TextView
                android:id="@+id/customerPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone: 9876543210"
                android:textSize="@dimen/text_size_sm"
                android:textColor="@color/md_theme_on_surface_variant"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/spacing_xs" />

        </LinearLayout>

        <!-- Status Badge -->
        <com.google.android.material.chip.Chip
            android:id="@+id/customerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active"
            android:textSize="@dimen/text_size_sm"
            app:chipBackgroundColor="@color/color_customers"
            app:chipStrokeWidth="0dp"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

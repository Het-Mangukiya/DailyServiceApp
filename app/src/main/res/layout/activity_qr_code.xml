<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_backdrop"
    android:fitsSystemWindows="true"
    tools:context=".qr.QRCodeActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_primary"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_primary"
            app:title="@string/menu_my_qr_code"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_base"
            android:gravity="center">

            <!-- QR Code Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="@dimen/elevation_md"
                app:strokeColor="#1A4DB6AC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qr_share_title"
                        android:textSize="@dimen/text_size_lg"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_on_surface"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qr_share_subtitle"
                        android:textSize="@dimen/text_size_base"
                        android:textColor="@color/md_theme_on_surface_variant"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/spacing_lg" />

                    <!-- QR Code Image -->
                    <ImageView
                        android:id="@+id/qrCodeImage"
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:layout_marginTop="@dimen/spacing_base"
                        android:layout_marginBottom="@dimen/spacing_base"
                        android:contentDescription="@string/qr_code_content_desc"
                        android:scaleType="fitCenter" />

                    <!-- Provider Name -->
                    <TextView
                        android:id="@+id/providerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_lg"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_primary"
                        android:layout_marginTop="@dimen/spacing_base"
                        tools:text="John Doe Services" />

                    <!-- Provider ID -->
                    <TextView
                        android:id="@+id/providerId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_sm"
                        android:textColor="@color/md_theme_on_surface_variant"
                        android:layout_marginTop="@dimen/spacing_xs"
                        tools:text="ID: ABC123XYZ" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_share_button"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_share"
                app:iconTint="@android:color/white"
                app:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="@dimen/corner_radius_base"
                android:layout_marginBottom="@dimen/spacing_base" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_save_button"
                android:textColor="@color/md_theme_primary"
                app:icon="@drawable/ic_download"
                app:iconTint="@color/md_theme_primary"
                app:strokeColor="@color/md_theme_primary"
                app:cornerRadius="@dimen/corner_radius_base" />

            <!-- Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/corner_radius_base"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/md_theme_primary_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_base"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info"
                        android:contentDescription="@string/qr_info_content_desc"
                        app:tint="@color/md_theme_primary"
                        android:layout_marginEnd="@dimen/spacing_base" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/qr_info_text"
                        android:textSize="@dimen/text_size_sm"
                        android:textColor="@color/md_theme_on_primary"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

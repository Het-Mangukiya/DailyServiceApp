<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fitsSystemWindows="true">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_primary"
        app:elevation="@dimen/elevation_md">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Service Entry"
            app:titleTextColor="@android:color/white">
            
            <TextView
                android:id="@+id/offlineIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:text="📴 Offline"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:padding="4dp"
                android:background="@android:color/holo_red_dark"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />
                
        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_base">

            <!-- Pending Sync Card (hidden by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pendingSyncCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_base"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_base"
                app:cardBackgroundColor="@android:color/holo_orange_light">

                <TextView
                    android:id="@+id/pendingSyncText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_base"
                    android:text="📤 3 deliveries pending sync"
                    android:textSize="@dimen/text_size_base"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Date Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dateSelectorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_base"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_base"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_base"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/card_size_md"
                        android:layout_height="@dimen/card_size_md"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        app:tint="@color/md_theme_primary"
                        android:layout_marginEnd="@dimen/spacing_base" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Selected Date"
                            android:textSize="@dimen/text_size_sm"
                            android:textColor="@color/md_theme_on_surface_variant" />

                        <TextView
                            android:id="@+id/selectedDateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today"
                            android:textSize="@dimen/text_size_lg"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_on_surface"
                            android:layout_marginTop="@dimen/spacing_xs" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeDateButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Change"
                        android:textSize="@dimen/text_size_base"
                        app:cornerRadius="@dimen/corner_radius_base" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- RecyclerView with Empty State -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/spacing_xl"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦"
                        android:textSize="@dimen/card_size_xxl"
                        android:layout_marginBottom="@dimen/spacing_base" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No customers found"
                        android:textSize="@dimen/text_size_lg"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_on_surface"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add customers first to record deliveries"
                        android:textSize="@dimen/text_size_base"
                        android:textColor="@color/md_theme_on_surface_variant"
                        android:gravity="center" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Mark Delivery Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMarkDelivery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/spacing_base"
        android:text="Mark Delivery"
        android:textSize="@dimen/text_size_base"
        android:textStyle="bold"
        android:paddingVertical="@dimen/spacing_base"
        app:cornerRadius="@dimen/corner_radius_button"
        app:backgroundTint="@color/md_theme_primary"
        style="@style/Widget.Material3.Button" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

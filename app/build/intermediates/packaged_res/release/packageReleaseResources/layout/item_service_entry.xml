<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_base"
    android:layout_marginVertical="@dimen/spacing_xs"
    app:cardCornerRadius="@dimen/corner_radius_card"
    app:cardElevation="@dimen/elevation_card"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_base"
        android:gravity="center_vertical">

        <!-- Checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkboxDelivered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <!-- Customer Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_base"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/customer_default"
                android:textSize="@dimen/text_size_base"
                android:textStyle="bold"
                android:textColor="@color/md_theme_on_surface" />

            <TextView
                android:id="@+id/txtServiceDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/service_quantity_placeholder"
                android:textSize="@dimen/text_size_sm"
                android:textColor="@color/text_muted"
                android:layout_marginTop="@dimen/spacing_xxs" />
            
            <TextView
                android:id="@+id/txtAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/address"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Quantity Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDecreaseQty"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_delete_24"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <TextView
                android:id="@+id/txtQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/customer_quantity_placeholder"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                android:textColor="@color/md_theme_primary"
                android:minWidth="48dp"
                android:gravity="center"
                android:layout_marginHorizontal="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIncreaseQty"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_add_24"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

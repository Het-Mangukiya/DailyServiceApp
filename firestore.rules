rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && uid == request.auth.uid;
    }

    function ownsCustomer(customerId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/customers/$(customerId)).data.providerId == request.auth.uid;
    }

    match /providers/{providerId} {
      // Any signed-in user can read provider profile for QR-based linking.
      allow read: if isSignedIn();
      allow delete: if isOwner(providerId);
      allow create: if isOwner(providerId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(providerId)
        && request.resource.data.userId == request.auth.uid
        && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      // Each authenticated user can manage only their own auth profile document.
      allow read, create, update, delete: if isOwner(userId);
    }

    match /customerLinks/{customerId} {
      // Customer-owned link document used for provider QR linking.
      allow read: if isOwner(customerId)
        || (isSignedIn() && resource.data.providerId == request.auth.uid);
      allow delete: if isOwner(customerId);
      allow create: if isOwner(customerId)
        && request.resource.data.customerId == request.auth.uid;
      allow update: if (isOwner(customerId)
          && request.resource.data.customerId == request.auth.uid)
        || (isSignedIn()
          && resource.data.providerId == request.auth.uid
          && request.resource.data.providerId == resource.data.providerId
          && request.resource.data.customerId == resource.data.customerId);
    }

    match /customers/{customerId} {
      // Allow get on non-existent docs (resource == null) so providers can check
      // before creating during join-request approval.
      allow get: if isOwner(customerId)
        || (isSignedIn()
          && (resource == null || resource.data.providerId == request.auth.uid));
      allow list, delete: if isSignedIn() && resource.data.providerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.providerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId;

      match /deliveries/{deliveryId} {
        allow read, write: if ownsCustomer(customerId);
      }

      match /payments/{paymentId} {
        allow read, write: if ownsCustomer(customerId);
      }
    }

    match /serviceEntries/{entryId} {
      allow read: if isSignedIn()
        && (resource.data.providerId == request.auth.uid
          || resource.data.customerId == request.auth.uid);
      allow delete: if isSignedIn()
        && resource.data.providerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.providerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId;
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn()
        && (resource.data.providerId == request.auth.uid
          || resource.data.customerId == request.auth.uid);
      allow delete: if isSignedIn()
        && resource.data.providerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.providerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId;
    }

    match /bills/{billId} {
      allow read: if isSignedIn()
        && (resource.data.providerId == request.auth.uid
          || resource.data.customerId == request.auth.uid);
      allow delete: if isSignedIn()
        && resource.data.providerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.providerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId;
    }

    // Legacy root collection support.
    match /deliveries/{deliveryId} {
      allow read, delete: if isSignedIn()
        && resource.data.providerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.providerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.providerId == resource.data.providerId;
    }
  }
}
